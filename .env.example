# 环境变量配置示例文件
# 请复制为 .env 文件并填入实际值

# 智谱AI配置 - 必填项
# 获取地址：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=你的智谱AI密钥

# 智谱AI模型选择（可选）
ZHIPUAI_MODEL=glm-4

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI配置
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# 通义千问配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 文心一言配置
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# 讯飞星火配置
XUNFEI_APP_ID=your_xunfei_app_id_here
XUNFEI_API_KEY=your_xunfei_api_key_here
XUNFEI_API_SECRET=your_xunfei_api_secret_here

# 数据库配置
DATABASE_URL=sqlite:///./cwzx.db

# API服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 前端服务配置
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8081

# 调试模式
DEBUG=True

# 日志级别
LOG_LEVEL=INFO

# CORS设置
ALLOWED_ORIGINS=*

# 缓存配置
CACHE_TTL=3600

# 股票数据更新间隔(秒)
STOCK_UPDATE_INTERVAL=30

# Elasticsearch 配置（backend/services/elasticsearch_service.py 会读取，缺省为下面这两个值）
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=financial_news
